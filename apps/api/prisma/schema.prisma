  crmClientReferenceId String?                  @db.Uuid
  payloadHash          String                   @db.VarChar(64)
  status               LegacyImportRecordStatus
  errorCode            String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([source, legacyClientId])
  @@index([crmClientId])
  @@index([crmClientReferenceId])
  @@index([status])
  @@index([createdAt])
  @@map("legacy_import_records")
}

model LegacyFinancialImportRecord {
