generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum ClientStatus {
  PENDENTE_PAGAMENTO
  ATIVO
  INATIVO
  CANCELADO
}

enum ClientEventType {
  CLIENT_CREATED
  CLIENT_UPDATED
  STATUS_CHANGED
  CLIENT_RENEWED
  PAYMENT_REGISTERED
  PIX_PAYMENT_INTENT_CREATED
  PIX_PAYMENT_STATUS_UPDATED
  RECEIVABLE_CANCELED
  FINANCIAL_TRANSACTION_CREATED
  WHATSAPP_MESSAGE_SENT
  RECOVERY_CAMPAIGN_STARTED
  RECOVERY_CAMPAIGN_CANCELED
  RECOVERY_CAMPAIGN_COMPLETED
  REFERRAL_CREATED
  REFERRAL_QUALIFIED
  REFERRAL_REWARD_APPLIED
  REFERRAL_CANCELED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  CANCELED
}

enum ReferralRewardType {
  FREE_MONTH
  CREDIT
  CUSTOM
}

enum ReceivableStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum ReceivablePurpose {
  RENEWAL
  INITIAL_ACTIVATION
}

enum FinancialTransactionType {
  ENTRADA
  SAIDA
}

enum FinancialTransactionOrigin {
  RECEIVABLE_PAYMENT
  MANUAL
}

enum PaymentProviderCode {
  MOCK
  FASTFLOW
  FASTPAY
  DEPIX
}

enum PaymentIntentStatus {
  CREATED
  WAITING_PAYMENT
  PAID
  EXPIRED
  CANCELED
  FAILED
  REFUNDED
}

enum WhatsAppProvider {
  KIRAGO
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  CONNECTED
  ERROR
}

enum MessageDispatchOrigin {
  MANUAL
  INITIAL_ACTIVATION
  BILLING
  RECOVERY
}

enum MessageDispatchStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELED
  IGNORED
}

enum MessageTemplateType {
  INITIAL_ACTIVATION
  BILLING_DUE
  RECOVERY_DAY_3
  RECOVERY_DAY_10
  RECOVERY_DAY_15
  RECOVERY_DAY_30
}

enum RecoveryCampaignStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum RecoveryCampaignStepStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELED
  IGNORED
}

enum WhatsAppPendingContactStatus {
  PENDENTE
  APROVADO
  IGNORADO
}

enum WhatsAppMessageDirection {
  INCOMING
  OUTGOING
}

enum WhatsAppInboundMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  LIVE_LOCATION
  CONTACT
  CONTACTS
  REACTION
  BUTTON_RESPONSE
  LIST_RESPONSE
  INTERACTIVE_RESPONSE
  UNKNOWN
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  UserRole               @default(ADMIN)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdClientEvents   ClientEvent[]          @relation("ClientEventCreatedBy")
  changedClientStatuses ClientStatusHistory[]  @relation("ClientStatusChangedBy")
  createdRenewals       Renewal[]              @relation("RenewalCreatedBy")
  createdTransactions   FinancialTransaction[] @relation("FinancialTransactionCreatedBy")
  createdReferrals      Referral[]             @relation("ReferralCreatedBy")

  @@map("users")
}

model Plan {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique
  durationMonths Int
  defaultValue   Decimal   @db.Decimal(12, 2)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  clients        Client[]
  clientReferences ClientReference[]
  renewals       Renewal[]

  @@map("plans")
}

model Client {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  phone                   String
  phoneNormalized         String
  email                   String?
  reference               String                   @unique
  planId                  String                   @db.Uuid
  recurringValue          Decimal                  @db.Decimal(12, 2)
  dueDate                 DateTime                 @db.Date
  billingAnchorDay        Int
  billingNoticeDays       Int
  notes                   String?
  status                  ClientStatus             @default(ATIVO)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  plan                    Plan                     @relation(fields: [planId], references: [id], onDelete: Restrict)
  references              ClientReference[]
  statusHistory           ClientStatusHistory[]
  events                  ClientEvent[]
  renewals                Renewal[]
  receivables             Receivable[]
  financialTransactions   FinancialTransaction[]
  messageDispatches       MessageDispatch[]
  recoveryCampaigns       RecoveryCampaign[]
  whatsappPendingContacts WhatsAppPendingContact[]
  whatsappInboundMessages WhatsAppInboundMessage[]
  referralReceived        Referral?                @relation("ReferralReferredClient")
  referralsMade           Referral[]               @relation("ReferralReferrerClient")

  @@index([status])
  @@index([planId])
  @@index([dueDate])
  @@index([createdAt])
  @@map("clients")
}

model ClientReference {
  id                   String                  @id @default(uuid()) @db.Uuid
  clientId             String                  @db.Uuid
  reference            String                  @unique
  planId               String                  @db.Uuid
  recurringValue       Decimal                 @db.Decimal(12, 2)
  dueDate              DateTime                @db.Date
  billingAnchorDay     Int
  billingNoticeDays    Int
  status               ClientStatus            @default(ATIVO)
  notes                String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  plan                 Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  renewals             Renewal[]
  receivables          Receivable[]
  recoveryCampaigns    RecoveryCampaign[]
  messageDispatches    MessageDispatch[]
  financialTransactions FinancialTransaction[]
  statusHistory        ClientStatusHistory[]
  rewardedReferrals    Referral[]              @relation("ReferralRewardClientReference")

  @@index([clientId])
  @@index([planId])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@map("client_references")
}

model WhatsAppConnection {
  id                     String                   @id @default(uuid()) @db.Uuid
  name                   String
  provider               WhatsAppProvider         @default(KIRAGO)
  providerUserId         String?
  providerInstanceName   String?
  providerTokenEncrypted String
  phone                  String?
  status                 WhatsAppConnectionStatus @default(DISCONNECTED)
  connected              Boolean                  @default(false)
  loggedIn               Boolean                  @default(false)
  webhookConfigured      Boolean                  @default(false)
  lastStatusAt           DateTime?
  connectedAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  messageDispatches      MessageDispatch[]
  pendingContacts        WhatsAppPendingContact[]
  inboundMessages        WhatsAppInboundMessage[]

  @@index([provider])
  @@index([providerInstanceName])
  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_connections")
}

model MessageDispatch {
  id                   String                @id @default(uuid()) @db.Uuid
  clientId             String?               @db.Uuid
  clientReferenceId    String?               @db.Uuid
  receivableId         String?               @db.Uuid
  templateId           String?               @db.Uuid
  whatsAppConnectionId String?               @db.Uuid
  recoveryCampaignId   String?               @db.Uuid
  phone                String
  body                 String
  renderedContent      String?
  origin               MessageDispatchOrigin @default(MANUAL)
  status               MessageDispatchStatus @default(PENDING)
  requestId            String                @unique
  idempotencyKey       String?               @unique
  scheduledFor         DateTime?
  nextAttemptAt        DateTime?
  attempts             Int                   @default(0)
  providerMessageId    String?
  errorCode            String?
  errorMessage         String?
  sentAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientReference      ClientReference?      @relation(fields: [clientReferenceId], references: [id], onDelete: SetNull)
  receivable           Receivable?           @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  template             MessageTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  whatsAppConnection   WhatsAppConnection?   @relation(fields: [whatsAppConnectionId], references: [id], onDelete: SetNull)
  recoveryCampaign     RecoveryCampaign?     @relation(fields: [recoveryCampaignId], references: [id], onDelete: SetNull)
  recoveryStep         RecoveryCampaignStep?

  @@index([clientId])
  @@index([clientReferenceId])
  @@index([receivableId])
  @@index([templateId])
  @@index([whatsAppConnectionId])
  @@index([recoveryCampaignId])
  @@index([status])
  @@index([origin])
  @@index([scheduledFor])
  @@index([nextAttemptAt])
  @@index([createdAt])
  @@map("message_dispatches")
}

model MessageTemplate {
  id                String                 @id @default(uuid()) @db.Uuid
  name              String
  type              MessageTemplateType
  content           String
  active            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  messageDispatches MessageDispatch[]
  recoverySteps     RecoveryCampaignStep[]

  @@unique([type, name])
  @@index([type])
  @@index([active])
  @@map("message_templates")
}

model BillingAutomationSettings {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String   @unique @default("global")
  enabled   Boolean  @default(false)
  sendTime  String   @default("09:00") @db.VarChar(5)
  timezone  String   @default("America/Sao_Paulo")
  companyId String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("billing_automation_settings")
}

model RecoveryCampaign {
  id                String                 @id @default(uuid()) @db.Uuid
  clientId          String                 @db.Uuid
  clientReferenceId String                 @db.Uuid
  status            RecoveryCampaignStatus @default(ATIVA)
  startedAt         DateTime
  completedAt       DateTime?
  canceledAt        DateTime?
  cancelReason      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  client            Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientReference   ClientReference        @relation(fields: [clientReferenceId], references: [id], onDelete: Restrict)
  steps             RecoveryCampaignStep[]
  messageDispatches MessageDispatch[]

  @@index([clientId])
  @@index([clientReferenceId])
  @@index([status])
  @@index([startedAt])
  @@map("recovery_campaigns")
}

model RecoveryCampaignStep {
  id           String                     @id @default(uuid()) @db.Uuid
  campaignId   String                     @db.Uuid
  stepNumber   Int
  delayDays    Int
  templateId   String?                    @db.Uuid
  dispatchId   String?                    @unique @db.Uuid
  scheduledFor DateTime
  status       RecoveryCampaignStepStatus @default(SCHEDULED)
  sentAt       DateTime?
  canceledAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  campaign     RecoveryCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template     MessageTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  dispatch     MessageDispatch?           @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
  @@index([templateId])
  @@index([status])
  @@index([scheduledFor])
  @@map("recovery_campaign_steps")
}

model WhatsAppPendingContact {
  id                   String                       @id @default(uuid()) @db.Uuid
  whatsAppConnectionId String                       @db.Uuid
  phone                String
  phoneNormalized      String
  contactName          String?
  status               WhatsAppPendingContactStatus @default(PENDENTE)
  firstMessageText     String?
  lastMessageText      String?
  firstMessageType     WhatsAppInboundMessageType
  lastMessageType      WhatsAppInboundMessageType
  firstMessageId       String?
  lastMessageId        String?
  firstContactAt       DateTime
  lastContactAt        DateTime
  messageCount         Int                          @default(1)
  clientId             String?                      @db.Uuid
  approvedAt           DateTime?
  ignoredAt            DateTime?
  ignoreReason         String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  whatsAppConnection   WhatsAppConnection           @relation(fields: [whatsAppConnectionId], references: [id], onDelete: Restrict)
  client               Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  inboundMessages      WhatsAppInboundMessage[]

  @@unique([whatsAppConnectionId, phoneNormalized])
  @@index([status])
  @@index([phoneNormalized])
  @@index([lastContactAt])
  @@index([whatsAppConnectionId])
  @@index([clientId])
  @@map("whatsapp_pending_contacts")
}

model WhatsAppInboundMessage {
  id                   String                     @id @default(uuid()) @db.Uuid
  whatsAppConnectionId String                     @db.Uuid
  pendingContactId     String?                    @db.Uuid
  clientId             String?                    @db.Uuid
  providerMessageId    String?
  phoneNormalized      String?
  direction            WhatsAppMessageDirection
  messageType          WhatsAppInboundMessageType
  text                 String?
  messageTimestamp     DateTime?
  receivedAt           DateTime                   @default(now())
  contactName          String?
  instanceName         String?
  providerUserId       String?
  mediaMetadata        Json?
  createdAt            DateTime                   @default(now())
  whatsAppConnection   WhatsAppConnection         @relation(fields: [whatsAppConnectionId], references: [id], onDelete: Restrict)
  pendingContact       WhatsAppPendingContact?    @relation(fields: [pendingContactId], references: [id], onDelete: SetNull)
  client               Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([whatsAppConnectionId, providerMessageId])
  @@index([phoneNormalized])
  @@index([messageTimestamp])
  @@index([receivedAt])
  @@index([whatsAppConnectionId])
  @@index([pendingContactId])
  @@index([clientId])
  @@map("whatsapp_inbound_messages")
}

model Renewal {
  id              String      @id @default(uuid()) @db.Uuid
  clientId        String      @db.Uuid
  clientReferenceId String    @db.Uuid
  planId          String      @db.Uuid
  previousDueDate DateTime    @db.Date
  newDueDate      DateTime    @db.Date
  amount          Decimal     @db.Decimal(12, 2)
  planName        String
  durationMonths  Int
  idempotencyKey  String?
  createdByUserId String?     @db.Uuid
  createdAt       DateTime    @default(now())
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientReference ClientReference @relation(fields: [clientReferenceId], references: [id], onDelete: Restrict)
  plan            Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy       User?       @relation("RenewalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  receivable      Receivable?

  @@unique([clientId, idempotencyKey])
  @@unique([clientReferenceId, idempotencyKey])
  @@index([clientId])
  @@index([clientReferenceId])
  @@index([planId])
  @@index([createdAt])
  @@map("renewals")
}

model Receivable {
  id                 String                @id @default(uuid()) @db.Uuid
  clientId           String                @db.Uuid
  clientReferenceId  String                @db.Uuid
  renewalId          String?               @unique @db.Uuid
  purpose            ReceivablePurpose     @default(RENEWAL)
  description        String
  amount             Decimal               @db.Decimal(12, 2)
  dueDate            DateTime              @db.Date
  status             ReceivableStatus      @default(PENDENTE)
  paidAt             DateTime?             @db.Date
  canceledAt         DateTime?
  cancelReason       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientReference    ClientReference       @relation(fields: [clientReferenceId], references: [id], onDelete: Restrict)
  renewal            Renewal?              @relation(fields: [renewalId], references: [id], onDelete: Restrict)
  paymentTransaction FinancialTransaction?
  messageDispatches  MessageDispatch[]
  paymentIntents     PaymentIntent[]

  @@index([clientId])
  @@index([clientReferenceId])
  @@index([dueDate])
  @@index([status])
  @@index([purpose])
  @@map("receivables")
}

model PaymentIntent {
  id                    String                @id @default(uuid()) @db.Uuid
  receivableId          String                @db.Uuid
  provider              PaymentProviderCode
  providerTransactionId String?
  externalStatus        String?
  externalDepixId       String?
  blockchainTxId        String?
  status                PaymentIntentStatus   @default(CREATED)
  amount                Decimal               @db.Decimal(12, 2)
  pixCopyPaste          String?
  qrCodeData            String?
  expiresAt             DateTime?
  paidAt                DateTime?
  lastSyncAt            DateTime?
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  receivable            Receivable            @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  webhookEvents         PaymentWebhookEvent[]

  @@unique([provider, providerTransactionId])
  @@index([receivableId])
  @@index([provider])
  @@index([status])
  @@index([expiresAt])
  @@map("payment_intents")
}

model PaymentProviderCredential {
  id                     String              @id @default(uuid()) @db.Uuid
  provider               PaymentProviderCode
  name                   String
  tokenEncrypted         String
  tokenLastFour          String
  webhookSecretEncrypted String?
  webhookSecretLastFour  String?
  webhookConfiguredAt    DateTime?
  webhookUrl             String?
  webhookRegisteredAt    DateTime?
  defaultForPix          Boolean             @default(false)
  active                 Boolean             @default(true)
  validatedAt            DateTime?
  lastValidationStatus   String?
  companyId              String?             @db.Uuid
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([provider])
  @@index([active])
  @@index([defaultForPix])
  @@index([companyId])
  @@map("payment_provider_credentials")
}

model PaymentWebhookEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  provider              PaymentProviderCode
  providerTransactionId String
  status                String
  eventKey              String
  paymentIntentId       String?             @db.Uuid
  processedAt           DateTime            @default(now())
  createdAt             DateTime            @default(now())
  paymentIntent         PaymentIntent?      @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId, status, eventKey])
  @@index([provider])
  @@index([providerTransactionId])
  @@index([paymentIntentId])
  @@map("payment_webhook_events")
}

model FinancialCategory {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String
  type         FinancialTransactionType
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  transactions FinancialTransaction[]

  @@unique([name, type])
  @@index([type])
  @@index([active])
  @@map("financial_categories")
}

model FinancialTransaction {
  id              String                     @id @default(uuid()) @db.Uuid
  type            FinancialTransactionType
  origin          FinancialTransactionOrigin @default(MANUAL)
  categoryId      String                     @db.Uuid
  clientId        String?                    @db.Uuid
  clientReferenceId String?                  @db.Uuid
  receivableId    String?                    @unique @db.Uuid
  description     String
  amount          Decimal                    @db.Decimal(12, 2)
  transactionDate DateTime                   @db.Date
  notes           String?
  createdByUserId String?                    @db.Uuid
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  category        FinancialCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  client          Client?                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientReference ClientReference?           @relation(fields: [clientReferenceId], references: [id], onDelete: Restrict)
  receivable      Receivable?                @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  createdBy       User?                      @relation("FinancialTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([origin])
  @@index([categoryId])
  @@index([clientId])
  @@index([clientReferenceId])
  @@index([transactionDate])
  @@index([createdAt])
  @@map("financial_transactions")
}

model Referral {
  id                     String             @id @default(uuid()) @db.Uuid
  referredClientId       String             @unique @db.Uuid
  referrerClientId       String             @db.Uuid
  status                 ReferralStatus     @default(PENDING)
  rewardType             ReferralRewardType @default(FREE_MONTH)
  rewardValue            Decimal?           @db.Decimal(12, 2)
  rewardDescription      String?
  qualifiedAt            DateTime?
  appliedAt              DateTime?
  canceledAt             DateTime?
  cancellationReason     String?
  appliedPreviousDueDate DateTime?          @db.Date
  appliedNewDueDate      DateTime?          @db.Date
  rewardClientReferenceId String?           @db.Uuid
  createdByUserId        String?            @db.Uuid
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  referredClient         Client             @relation("ReferralReferredClient", fields: [referredClientId], references: [id], onDelete: Restrict)
  referrerClient         Client             @relation("ReferralReferrerClient", fields: [referrerClientId], references: [id], onDelete: Restrict)
  rewardClientReference  ClientReference?   @relation("ReferralRewardClientReference", fields: [rewardClientReferenceId], references: [id], onDelete: SetNull)
  createdBy              User?              @relation("ReferralCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([referrerClientId])
  @@index([status])
  @@index([rewardType])
  @@index([rewardClientReferenceId])
  @@index([createdAt])
  @@index([qualifiedAt])
  @@index([appliedAt])
  @@map("referrals")
}

model ClientStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  clientId        String       @db.Uuid
  clientReferenceId String?    @db.Uuid
  previousStatus  ClientStatus
  newStatus       ClientStatus
  reason          String?
  changedByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientReference ClientReference? @relation(fields: [clientReferenceId], references: [id], onDelete: SetNull)
  changedBy       User?        @relation("ClientStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([clientReferenceId])
  @@index([createdAt])
  @@map("client_status_history")
}

model ClientEvent {
  id              String          @id @default(uuid()) @db.Uuid
  clientId        String          @db.Uuid
  type            ClientEventType
  title           String
  description     String?
  metadata        Json?
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy       User?           @relation("ClientEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([type])
  @@index([createdAt])
  @@map("client_events")
}
