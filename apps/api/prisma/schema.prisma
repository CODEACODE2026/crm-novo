  reactivation                ClientReferenceReactivation?
  paymentGroupItems           PaymentGroupItem[]
  recoveryCampaigns           RecoveryCampaign[]
  messageDispatches           MessageDispatch[]
  messageDispatchItems        MessageDispatchItem[]
  paymentIntents              PaymentIntent[]
  billingResponses            BillingResponse[]
  auditEvents                 ReceivableAuditEvent[]
  billingExecutionReceivables BillingExecutionReceivable[]
  qualifiedReferral           Referral?                    @relation("ReferralQualificationReceivable")

  @@index([clientId])
  @@index([clientReferenceId])
  @@index([financialCategoryId])
  @@index([payerPhoneNormalized])
  @@index([manualChargeIdempotencyKey])
  @@index([dueDate])
  @@index([status])
  @@index([purpose])
  @@map("receivables")
}

model ClientReferenceReactivation {
  id                       String                            @id @default(uuid()) @db.Uuid
  clientId                 String                            @db.Uuid
  clientReferenceId        String                            @db.Uuid
  receivableId             String                            @unique @db.Uuid
  planId                   String                            @db.Uuid
  previousPlanId           String?                           @db.Uuid
  previousPlanName         String?
  previousAmount           Decimal?                          @db.Decimal(12, 2)
  previousDueDate          DateTime?                         @db.Date
  previousBillingAnchorDay Int?
  previousStatus           ClientStatus?
  activationDate           DateTime                          @db.Date
  billingAnchorDay         Int
  recurringValue           Decimal                           @db.Decimal(12, 2)
  status                   ClientReferenceReactivationStatus @default(PENDING)
  idempotencyKey           String
  createdByUserId          String?                           @db.Uuid
  paidAt                   DateTime?
  canceledAt               DateTime?
  cancelReason             String?
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  client                   Client                            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientReference          ClientReference                   @relation(fields: [clientReferenceId], references: [id], onDelete: Restrict)
  receivable               Receivable                        @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  plan                     Plan                              @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy                User?                             @relation("ClientReferenceReactivationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([clientReferenceId, idempotencyKey])
  @@index([clientId])
  @@index([clientReferenceId])
  @@index([planId])
  @@index([status])
  @@map("client_reference_reactivations")
}

model PaymentIntent {
  id                    String                 @id @default(uuid()) @db.Uuid
  receivableId          String?                @db.Uuid
  paymentGroupId        String?                @db.Uuid
  provider              PaymentProviderCode
  providerTransactionId String?
  externalStatus        String?
  externalDepixId       String?
  blockchainTxId        String?
  status                PaymentIntentStatus    @default(CREATED)
  origin                PaymentIntentOrigin    @default(MANUAL)
  creationKey           String?                @unique
  amount                Decimal                @db.Decimal(12, 2)
  pixCopyPaste          String?
  qrCodeData            String?
  expiresAt             DateTime?
  paidAt                DateTime?
  lastSyncAt            DateTime?
  failureCode           String?
  failureMessage        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  receivable            Receivable?            @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  paymentGroup          PaymentGroup?          @relation(fields: [paymentGroupId], references: [id], onDelete: Restrict)
  webhookEvents         PaymentWebhookEvent[]
  receivableAuditEvents ReceivableAuditEvent[]
  billingExecution      BillingExecution?
  billingPixAttempt     BillingPixAttempt?
  orphanCorrelationEvents BillingPixOrphanWebhookCorrelationEvent[]
  orphanCorrelationClaims BillingPixOrphanWebhookCorrelationClaim[]
  messageDispatch       MessageDispatch?

  @@unique([provider, providerTransactionId])
  @@index([receivableId])
  @@index([paymentGroupId])
  @@index([provider])
  @@index([status])
  @@index([origin])
  @@index([expiresAt])
  @@map("payment_intents")
}

model PaymentGroup {
  id                    String                 @id @default(uuid()) @db.Uuid
  clientId              String                 @db.Uuid
  status                PaymentGroupStatus     @default(CREATED)
  totalAmount           Decimal                @db.Decimal(12, 2)
  paidAt                DateTime?              @db.Date
  createdByUserId       String?                @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy             User?                  @relation("PaymentGroupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items                 PaymentGroupItem[]
  paymentIntents        PaymentIntent[]
  financialTransactions FinancialTransaction[]

  @@index([clientId])
  @@index([status])
  @@index([paidAt])
  @@index([createdAt])
  @@map("payment_groups")
}

model PaymentGroupItem {
  id             String       @id @default(uuid()) @db.Uuid
  paymentGroupId String       @db.Uuid
  receivableId   String       @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  paymentGroup   PaymentGroup @relation(fields: [paymentGroupId], references: [id], onDelete: Cascade)
  receivable     Receivable   @relation(fields: [receivableId], references: [id], onDelete: Restrict)

  @@unique([paymentGroupId, receivableId])
  @@index([receivableId])
  @@map("payment_group_items")
}

model PaymentProviderCredential {
  id                     String              @id @default(uuid()) @db.Uuid
  provider               PaymentProviderCode
  name                   String
  tokenEncrypted         String
  tokenLastFour          String
  webhookSecretEncrypted String?
  webhookSecretLastFour  String?
  webhookConfiguredAt    DateTime?
  webhookUrl             String?
  webhookRegisteredAt    DateTime?
  defaultForPix          Boolean             @default(false)
  active                 Boolean             @default(true)
  validatedAt            DateTime?
  lastValidationStatus   String?
  companyId              String?             @db.Uuid
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([provider])
  @@index([active])
  @@index([defaultForPix])
  @@index([companyId])
  @@map("payment_provider_credentials")
}

model PaymentWebhookEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  provider              PaymentProviderCode
  providerTransactionId String
  status                String
  eventKey              String
  paymentIntentId       String?             @db.Uuid
  processedAt           DateTime            @default(now())
  createdAt             DateTime            @default(now())
  paymentIntent         PaymentIntent?      @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId, status, eventKey])
  @@index([provider])
  @@index([providerTransactionId])
  @@index([paymentIntentId])
  @@map("payment_webhook_events")
}

model FinancialCategory {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String
  type         FinancialTransactionType
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  transactions FinancialTransaction[]
  receivables  Receivable[]

  @@unique([name, type])
  @@index([type])
  @@index([active])
  @@map("financial_categories")
}

model ReceivableAuditEvent {
  id                    String                   @id @default(uuid()) @db.Uuid
  receivableId          String                   @db.Uuid
  paymentIntentId       String?                  @db.Uuid
  messageDispatchId     String?                  @db.Uuid
  eventType             ReceivableAuditEventType
  actorUserId           String?                  @db.Uuid
  provider              PaymentProviderCode?
  providerTransactionId String?
  payerNameSnapshot     String?
  payerPhoneMasked      String?
  metadata              Json?
  createdAt             DateTime                 @default(now())
  receivable            Receivable               @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  paymentIntent         PaymentIntent?           @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  messageDispatch       MessageDispatch?         @relation(fields: [messageDispatchId], references: [id], onDelete: SetNull)
  actorUser             User?                    @relation("ReceivableAuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([receivableId])
  @@index([paymentIntentId])
  @@index([messageDispatchId])
  @@index([eventType])
  @@index([actorUserId])
  @@index([provider, providerTransactionId])
  @@index([createdAt])
  @@map("receivable_audit_events")
}

model FinancialTransaction {
  id                String                     @id @default(uuid()) @db.Uuid
  type              FinancialTransactionType
  origin            FinancialTransactionOrigin @default(MANUAL)
  paymentMethod     FinancialPaymentMethod?
  categoryId        String                     @db.Uuid
  clientId          String?                    @db.Uuid
  clientReferenceId String?                    @db.Uuid
  receivableId      String?                    @unique @db.Uuid
  paymentGroupId    String?                    @db.Uuid
  description       String
  amount            Decimal                    @db.Decimal(12, 2)
  transactionDate   DateTime                   @db.Date
  notes             String?
  createdByUserId   String?                    @db.Uuid
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  category          FinancialCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  client            Client?                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientReference   ClientReference?           @relation(fields: [clientReferenceId], references: [id], onDelete: Restrict)
  receivable        Receivable?                @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  paymentGroup      PaymentGroup?              @relation(fields: [paymentGroupId], references: [id], onDelete: Restrict)
  createdBy         User?                      @relation("FinancialTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([origin])
  @@index([paymentMethod])
  @@index([categoryId])
  @@index([clientId])
  @@index([clientReferenceId])
  @@index([paymentGroupId])
  @@index([transactionDate])
  @@index([createdAt])
  @@map("financial_transactions")
}

model Referral {
  id                        String             @id @default(uuid()) @db.Uuid
  referredClientId          String             @db.Uuid
  referredClientReferenceId String?            @unique @db.Uuid
  referrerClientId          String             @db.Uuid
  status                    ReferralStatus     @default(PENDING)
  rewardType                ReferralRewardType @default(FREE_MONTH)
  origin                    ReferralOrigin     @default(AUTOMATIC)
  rewardValue               Decimal?           @db.Decimal(12, 2)
  rewardDescription         String?
  qualifiedAt               DateTime?
  appliedAt                 DateTime?
  canceledAt                DateTime?
  cancellationReason        String?
  appliedPreviousDueDate    DateTime?          @db.Date
  appliedNewDueDate         DateTime?          @db.Date
  rewardClientReferenceId   String?            @db.Uuid
  qualificationReceivableId String?            @unique @db.Uuid
  createdByUserId           String?            @db.Uuid
  canceledByUserId          String?            @db.Uuid
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  referredClient            Client             @relation("ReferralReferredClient", fields: [referredClientId], references: [id], onDelete: Restrict)
  referredClientReference   ClientReference?   @relation("ReferralReferredClientReference", fields: [referredClientReferenceId, referredClientId], references: [id, clientId], onDelete: Restrict)
  referrerClient            Client             @relation("ReferralReferrerClient", fields: [referrerClientId], references: [id], onDelete: Restrict)
  rewardClientReference     ClientReference?   @relation("ReferralRewardClientReference", fields: [rewardClientReferenceId], references: [id], onDelete: SetNull)
  qualificationReceivable   Receivable?        @relation("ReferralQualificationReceivable", fields: [qualificationReceivableId], references: [id], onDelete: SetNull)
  createdBy                 User?              @relation("ReferralCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  canceledBy                User?              @relation("ReferralCanceledBy", fields: [canceledByUserId], references: [id], onDelete: SetNull)
  history                   ReferralHistory[]

  @@index([referrerClientId])
  @@index([referredClientId])
  @@index([status])
  @@index([rewardType])
  @@index([origin])
  @@index([rewardClientReferenceId])
  @@index([canceledByUserId])
  @@index([createdAt])
  @@index([qualifiedAt])
  @@index([appliedAt])
  @@map("referrals")
}

model ReferralHistory {
  id          String                @id @default(uuid()) @db.Uuid
  referralId  String                @db.Uuid
  action      ReferralHistoryAction
  actorUserId String?               @db.Uuid
  reason      String?
  before      Json?
  after       Json?
  createdAt   DateTime              @default(now())
  referral    Referral              @relation(fields: [referralId], references: [id], onDelete: Cascade)
  actor       User?                 @relation("ReferralHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([referralId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("referral_history")
}

model ClientStatusHistory {
  id                String           @id @default(uuid()) @db.Uuid
  clientId          String           @db.Uuid
  clientReferenceId String?          @db.Uuid
  previousStatus    ClientStatus
  newStatus         ClientStatus
  reason            String?
  changedByUserId   String?          @db.Uuid
  createdAt         DateTime         @default(now())
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientReference   ClientReference? @relation(fields: [clientReferenceId], references: [id], onDelete: SetNull)
  changedBy         User?            @relation("ClientStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([clientReferenceId])
  @@index([createdAt])
  @@map("client_status_history")
}

model ClientEvent {
  id              String          @id @default(uuid()) @db.Uuid
  clientId        String          @db.Uuid
  type            ClientEventType
  title           String
  description     String?
  metadata        Json?
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy       User?           @relation("ClientEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([type])
  @@index([createdAt])
  @@map("client_events")
}

model LegacyImportRecord {
