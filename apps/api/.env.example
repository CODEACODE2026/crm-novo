NODE_ENV=development
PORT=3001
# In production behind Nginx, bind Nest locally/private instead of exposing it directly.
API_HOST=127.0.0.1
DATABASE_URL=postgresql://crm_novo:change-me@localhost:5432/crm_novo_dev?schema=public
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
APP_TIMEZONE=America/Sao_Paulo
BILLING_SCHEDULER_ENABLED=false
PHONE_INTERNATIONAL_ENABLED=false
PHONE_INTERNATIONAL_CLIENT_WRITE_ENABLED=false
PHONE_INTERNATIONAL_MANUAL_SEND_ENABLED=false
PHONE_INTERNATIONAL_MESSAGE_ACTIONS_ENABLED=false
PHONE_INTERNATIONAL_MANUAL_MEDIA_ENABLED=false
PHONE_INTERNATIONAL_MANUAL_MEDIA_COUNTRIES=
PHONE_INTERNATIONAL_MANUAL_VOICE_ENABLED=false
PHONE_INTERNATIONAL_MANUAL_VOICE_COUNTRIES=
PHONE_INTERNATIONAL_MANUAL_PIX_ENABLED=false
# Global manual WhatsApp kill switches. They are independent and fail closed.
PHONE_GLOBAL_MANUAL_TEXT_ENABLED=false
PHONE_GLOBAL_MESSAGE_ACTIONS_ENABLED=false
PHONE_GLOBAL_MANUAL_MEDIA_ENABLED=false
PHONE_GLOBAL_MANUAL_VOICE_ENABLED=false
# Automatic international Billing requires both this global flag and per-reference opt-in.
PHONE_INTERNATIONAL_BILLING_ENABLED=false
# Empty blocks every international country. Example controlled rollout: US,PT
PHONE_INTERNATIONAL_BILLING_COUNTRIES=
RECOVERY_SCHEDULER_ENABLED=false
KIRAGO_BASE_URL=https://kirago.example.com
KIRAGO_ADMIN_TOKEN=replace-with-kirago-admin-token
KIRAGO_WEBHOOK_TOKEN=replace-with-a-strong-kirago-webhook-token
KIRAGO_HTTP_TIMEOUT_MS=8000
# Public HTTPS base URL for API webhooks. Used by WhatsApp and payment webhook registration.
CRM_API_PUBLIC_URL=https://api.example.com
# Legacy fallback accepted by payment webhook registration; prefer CRM_API_PUBLIC_URL for new installs.
# CRM_PUBLIC_URL=https://api.example.com
# Optional explicit PIX notification URL. When set, this overrides the default null notification URL sent on PIX creation.
# FASTDEPIX_NOTIFICATION_URL=https://api.example.com/payment-webhooks/fastflow
# Mercado Pago remains fail-closed until a later rollout authorization.
MERCADO_PAGO_ENABLED=false
# TEST and PRODUCTION credentials are stored separately in the encrypted provider credential store.
MERCADO_PAGO_ENVIRONMENT=TEST
# Explicit test-only gate for Mercado Pago's official Pix approval simulator (payer.first_name=APRO).
MERCADO_PAGO_SANDBOX_APRO_ENABLED=false
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_IDENTITY_BASE_URL=https://api.mercadolibre.com
MERCADO_PAGO_HTTP_TIMEOUT_MS=8000
# TEST identity proof is renewed only by an authenticated credential validation.
MERCADO_PAGO_ENVIRONMENT_PROOF_TTL_MINUTES=1440
MERCADO_PAGO_WEBHOOK_MAX_AGE_MS=86400000
MERCADO_PAGO_WEBHOOK_FUTURE_TOLERANCE_MS=300000
MERCADO_PAGO_WEBHOOK_LEASE_MS=120000
WHATSAPP_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-encryption-key
# Disabled until a controlled disposable-charge homologation proves that KiraGo preserves the
# provider's original BR Code when PixPayment.Key is evaluated as EVP.
WHATSAPP_PIX_PAYMENT_NATIVE_ENABLED=false
# Explicit allowlist. Keep empty while the global gate is disabled.
WHATSAPP_PIX_PAYMENT_NATIVE_PROVIDERS=
# Private API-local storage for outbound WhatsApp media sent by the CRM.
# Production example: /var/lib/crm-novo/whatsapp-media
WHATSAPP_MEDIA_STORAGE_DIR=/var/lib/crm-novo/whatsapp-media
WHATSAPP_FFMPEG_PATH=/usr/bin/ffmpeg
WHATSAPP_VOICE_TEMP_DIR=/var/lib/crm-novo/whatsapp-media/tmp/audio4

# Required only when running pnpm --filter @crm-novo/api prisma:seed
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
