generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum ClientStatus {
  PENDENTE_PAGAMENTO
  ATIVO
  INATIVO
  CANCELADO
}

enum RenewalStatus {
  ACTIVE
  REVERTED
}

enum ClientEventType {
  CLIENT_CREATED
  CLIENT_UPDATED
  STATUS_CHANGED
  CLIENT_RENEWED
  CLIENT_REFERENCE_REACTIVATION_REQUESTED
  CLIENT_REFERENCE_REACTIVATED
  PAYMENT_REGISTERED
  PIX_PAYMENT_INTENT_CREATED
  PIX_PAYMENT_STATUS_UPDATED
  RECEIVABLE_CANCELED
  FINANCIAL_TRANSACTION_CREATED
  WHATSAPP_MESSAGE_SENT
  BILLING_RENEWAL_ACCEPTED
  BILLING_RENEWAL_DECLINED
  BILLING_RESPONSE_UNRESOLVED
  BILLING_RESPONSE_AMBIGUOUS
  BILLING_REFERENCE_DEACTIVATED
  RENEWAL_REVERTED
  RECOVERY_CAMPAIGN_STARTED
  RECOVERY_CAMPAIGN_CANCELED
  RECOVERY_CAMPAIGN_COMPLETED
  REFERRAL_CREATED
  REFERRAL_QUALIFIED
  REFERRAL_REWARD_APPLIED
  REFERRAL_CANCELED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  CANCELED
}

enum ReferralRewardType {
  FREE_MONTH
  CREDIT
  CUSTOM
}

enum ReferralOrigin {
  AUTOMATIC
  MANUAL
}

enum ReferralHistoryAction {
  CREATED
  QUALIFIED
  UPDATED
  CANCELED
  REWARD_APPLIED
}

enum ReceivableStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum ReceivablePurpose {
  RENEWAL
  INITIAL_ACTIVATION
  REACTIVATION
  MANUAL_CHARGE
}

enum ReceivableAuditEventType {
  MANUAL_CHARGE_CREATED
  PIX_CREATED
  PIX_REPLACED
  WHATSAPP_SENT
  PAID
  CANCELED
}

enum ClientReferenceReactivationStatus {
  PENDING
  PAID
  CANCELED
}

enum FinancialTransactionType {
  ENTRADA
  SAIDA
}

enum FinancialTransactionOrigin {
  RECEIVABLE_PAYMENT
  MANUAL
  LEGACY_IMPORT
}

enum FinancialPaymentMethod {
  PIX
  BOLETO
  CARTAO
  TRANSFERENCIA
}

enum PaymentProviderCode {
  MOCK
  FASTFLOW
  FASTPIX
  FASTPAY
  DEPIX
}

enum PaymentIntentStatus {
  CREATED
  WAITING_PAYMENT
  SUPERSEDED
  PAID
  EXPIRED
  CANCELED
  FAILED
  REFUNDED
}

enum PaymentIntentOrigin {
  MANUAL
  BILLING
}

enum PaymentGroupStatus {
  CREATED
  WAITING_PAYMENT
  PAID
  EXPIRED
  CANCELED
  FAILED
}

enum WhatsAppProvider {
  KIRAGO
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_REQUIRED
  CONNECTED
  ERROR
}

enum MessageDispatchOrigin {
  MANUAL
  INITIAL_ACTIVATION
  BILLING
  RECOVERY
}

enum MessageDispatchStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELED
  IGNORED
}

enum MessageTemplateType {
  INITIAL_ACTIVATION
  BILLING_DUE
  BILLING_DUE_GROUPED
  RECOVERY_DAY_3
  RECOVERY_DAY_7
  RECOVERY_DAY_10
  RECOVERY_DAY_15
  RECOVERY_DAY_30
}

enum BillingResponseDecision {
  PENDING
  ACCEPTED
  DECLINED
  UNRESOLVED
}

enum BillingExecutionStatus {
  SCHEDULED
  PROCESSING
  WAITING_PIX
  READY_TO_SEND
  COMPLETED
  BLOCKED
  REVIEW_REQUIRED
  CANCELED
}

enum BillingPixStatus {
  NOT_STARTED
  RESERVED
  CREATING
  CONFIRMED
  AMBIGUOUS
  FAILED
  EXPIRED
  PAID
  CANCELED
  SUPERSEDED
}

enum BillingDeliveryStatus {
  NOT_READY
  READY
  SENDING
  SENT
  AMBIGUOUS
  FAILED
  CANCELED
}

enum BillingAuthorizationMode {
  LEGACY_BRAZIL
  LEGACY_INTERNATIONAL
  GLOBAL_INTERNATIONAL
}

enum BillingActorType {
  USER
  SYSTEM
  WEBHOOK
}

enum BillingPixOrphanCorrelationDecision {
  REVIEW_REQUIRED
  CORRELATED
  CONFLICT_DETECTED
}

enum BillingAuditOrigin {
  BILLING
}

enum BillingExecutionEventType {
  EXECUTION_CREATED
  EXECUTION_STATUS_CHANGED
  PIX_ATTEMPT_RESERVED
  PIX_STATUS_CHANGED
  DELIVERY_STATUS_CHANGED
  REVIEW_REQUIRED
  RECONCILED
  CANCELED
}

enum RecoveryCampaignStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum RecoveryCampaignStepStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELED
  IGNORED
}

enum WhatsAppPendingContactStatus {
  PENDENTE
  APROVADO
  IGNORADO
}

enum WhatsAppMessageDirection {
  INCOMING
  OUTGOING
}

enum WhatsAppInboundMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  LIVE_LOCATION
  CONTACT
  CONTACTS
  REACTION
  BUTTON_RESPONSE
  LIST_RESPONSE
  INTERACTIVE_RESPONSE
  UNKNOWN
}

enum WhatsAppConversationStatus {
  OPEN
  RESOLVED
}

enum WhatsAppAttendanceStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum WhatsAppConversationLabelColor {
  BLUE
  GREEN
  YELLOW
  ORANGE
  RED
  PURPLE
  PINK
  TEAL
  GRAY
}

enum WhatsAppConversationMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppConversationMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppConversationMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  STICKER
  LOCATION
  CONTACT
  CONTACTS
  BUTTON
  UNKNOWN
}

enum WhatsAppAutoReplyMode {
  AWAY
  SERVICE_UNAVAILABLE
  CUSTOM
}

enum WhatsAppAutoReplyAudience {
  ALL
  LINKED_CLIENTS
  UNLINKED_CONTACTS
}

enum WhatsAppAutoReplyExecutionStatus {
  PENDING
  SENT
  FAILED
}

enum LegacyImportRecordStatus {
  IMPORTED
  UPDATED
  FAILED
}

model User {
  id                        String                        @id @default(uuid()) @db.Uuid
  name                      String
  email                     String                        @unique
  passwordHash              String
  role                      UserRole                      @default(ADMIN)
  active                    Boolean                       @default(true)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  createdClientEvents       ClientEvent[]                 @relation("ClientEventCreatedBy")
  changedClientStatuses     ClientStatusHistory[]         @relation("ClientStatusChangedBy")
  inactivatedReferences     ClientReference[]             @relation("ClientReferenceInactivatedBy")
  canceledReferences        ClientReference[]             @relation("ClientReferenceCanceledBy")
  createdRenewals           Renewal[]                     @relation("RenewalCreatedBy")
  createdRenewalReversals   RenewalReversal[]             @relation("RenewalReversalCreatedBy")
  createdReactivations      ClientReferenceReactivation[] @relation("ClientReferenceReactivationCreatedBy")
  createdTransactions       FinancialTransaction[]        @relation("FinancialTransactionCreatedBy")
  createdReferrals          Referral[]                    @relation("ReferralCreatedBy")
  canceledReferrals         Referral[]                    @relation("ReferralCanceledBy")
  referralHistoryEntries    ReferralHistory[]             @relation("ReferralHistoryActor")
  createdPaymentGroups      PaymentGroup[]                @relation("PaymentGroupCreatedBy")
  receivableAuditEvents     ReceivableAuditEvent[]        @relation("ReceivableAuditEventActor")
  billingExecutionEvents    BillingExecutionEvent[]       @relation("BillingExecutionEventActor")
  billingExecutionMutations BillingExecution[]            @relation("BillingExecutionLastActor")
  resolvedAttendances       WhatsAppAttendance[]          @relation("WhatsAppAttendanceResolvedBy")

  @@map("users")
}

model Plan {
  id               String                        @id @default(uuid()) @db.Uuid
  name             String                        @unique
  durationMonths   Int
  defaultValue     Decimal                       @db.Decimal(12, 2)
  active           Boolean                       @default(true)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  clients          Client[]
  clientReferences ClientReference[]
  renewals         Renewal[]
  reactivations    ClientReferenceReactivation[]

  @@map("plans")
}

model Client {
  id                      String                        @id @default(uuid()) @db.Uuid
  name                    String
  phone                   String
  phoneNormalized         String
  phoneE164               String?                       @db.VarChar(16)
  email                   String?
  reference               String                        @unique
  planId                  String                        @db.Uuid
  recurringValue          Decimal                       @db.Decimal(12, 2)
  dueDate                 DateTime                      @db.Date
  billingAnchorDay        Int
  billingNoticeDays       Int
  preferredPixProvider    PaymentProviderCode?
  notes                   String?
  status                  ClientStatus                  @default(ATIVO)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  plan                    Plan                          @relation(fields: [planId], references: [id], onDelete: Restrict)
  references              ClientReference[]
  statusHistory           ClientStatusHistory[]
  events                  ClientEvent[]
  renewals                Renewal[]
  renewalReversals        RenewalReversal[]
  reactivations           ClientReferenceReactivation[]
  receivables             Receivable[]
  financialTransactions   FinancialTransaction[]
  paymentGroups           PaymentGroup[]
  messageDispatches       MessageDispatch[]
  billingResponses        BillingResponse[]
  billingExecutions       BillingExecution[]
  recoveryCampaigns       RecoveryCampaign[]
  whatsappPendingContacts WhatsAppPendingContact[]
  whatsappInboundMessages WhatsAppInboundMessage[]
  whatsappConversations   WhatsAppConversation[]
  whatsappAttendances     WhatsAppAttendance[]
  referralsReceived       Referral[]                    @relation("ReferralReferredClient")
  referralsMade           Referral[]                    @relation("ReferralReferrerClient")

  @@index([status])
  @@index([planId])
  @@index([dueDate])
  @@index([createdAt])
  @@index([phoneE164])
  @@map("clients")
}

model ClientReference {
  id                          String                        @id @default(uuid()) @db.Uuid
  clientId                    String                        @db.Uuid
  reference                   String                        @unique
  planId                      String                        @db.Uuid
  recurringValue              Decimal                       @db.Decimal(12, 2)
  dueDate                     DateTime                      @db.Date
  billingAnchorDay            Int
  billingNoticeDays           Int
  internationalBillingEnabled Boolean                       @default(false)
  status                      ClientStatus                  @default(ATIVO)
  notes                       String?
  inactivatedAt               DateTime?
  inactivationReason          String?
  inactivatedByUserId         String?                       @db.Uuid
  canceledAt                  DateTime?
  cancellationReason          String?
  canceledByUserId            String?                       @db.Uuid
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  client                      Client                        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  plan                        Plan                          @relation(fields: [planId], references: [id], onDelete: Restrict)
  inactivatedBy               User?                         @relation("ClientReferenceInactivatedBy", fields: [inactivatedByUserId], references: [id], onDelete: SetNull)
  canceledBy                  User?                         @relation("ClientReferenceCanceledBy", fields: [canceledByUserId], references: [id], onDelete: SetNull)
  renewals                    Renewal[]
  renewalReversals            RenewalReversal[]
  reactivations               ClientReferenceReactivation[]
  receivables                 Receivable[]
  recoveryCampaigns           RecoveryCampaign[]
  messageDispatches           MessageDispatch[]
  messageDispatchItems        MessageDispatchItem[]
  billingResponses            BillingResponse[]
  billingExecutionReceivables BillingExecutionReceivable[]
  financialTransactions       FinancialTransaction[]
  statusHistory               ClientStatusHistory[]
  rewardedReferrals           Referral[]                    @relation("ReferralRewardClientReference")
  referredReferrals           Referral[]                    @relation("ReferralReferredClientReference")

  @@unique([id, clientId])
  @@index([clientId])
  @@index([planId])
  @@index([status])
  @@index([dueDate])
  @@index([inactivatedAt])
  @@index([canceledAt])
  @@index([createdAt])
  @@map("client_references")
}

model WhatsAppConnection {
  id                     String                       @id @default(uuid()) @db.Uuid
  name                   String
  provider               WhatsAppProvider             @default(KIRAGO)
  providerUserId         String?
  providerInstanceName   String?
  providerTokenEncrypted String
  phone                  String?
  status                 WhatsAppConnectionStatus     @default(DISCONNECTED)
  connected              Boolean                      @default(false)
  loggedIn               Boolean                      @default(false)
  webhookConfigured      Boolean                      @default(false)
  lastStatusAt           DateTime?
  connectedAt            DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  messageDispatches      MessageDispatch[]
  pendingContacts        WhatsAppPendingContact[]
  inboundMessages        WhatsAppInboundMessage[]
  conversations          WhatsAppConversation[]
  conversationMessages   WhatsAppMessage[]
  messageReactions       WhatsAppMessageReaction[]
  autoReplyConfig        WhatsAppAutoReplyConfig?
  autoReplyExecutions    WhatsAppAutoReplyExecution[]
  conversationLabels     WhatsAppConversationLabel[]
  attendanceCategories   WhatsAppAttendanceCategory[]
  attendances            WhatsAppAttendance[]

  @@index([provider])
  @@index([providerInstanceName])
  @@index([status])
  @@index([createdAt])
  @@map("whatsapp_connections")
}

model WhatsAppQuickReply {
  id        String   @id @default(uuid()) @db.Uuid
  label     String
  text      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([sortOrder])
  @@map("whatsapp_quick_replies")
}

model MessageDispatch {
  id                    String                 @id @default(uuid()) @db.Uuid
  clientId              String?                @db.Uuid
  clientReferenceId     String?                @db.Uuid
  receivableId          String?                @db.Uuid
  templateId            String?                @db.Uuid
  whatsAppConnectionId  String?                @db.Uuid
  recoveryCampaignId    String?                @db.Uuid
  paymentIntentId       String?                @unique @db.Uuid
  phone                 String
  body                  String
  renderedContent       String?
  origin                MessageDispatchOrigin  @default(MANUAL)
  status                MessageDispatchStatus  @default(PENDING)
  requestId             String                 @unique
  idempotencyKey        String?                @unique
  scheduledFor          DateTime?
  nextAttemptAt         DateTime?
  attempts              Int                    @default(0)
  providerMessageId     String?
  errorCode             String?
  errorMessage          String?
  sentAt                DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  client                Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientReference       ClientReference?       @relation(fields: [clientReferenceId], references: [id], onDelete: SetNull)
  receivable            Receivable?            @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  template              MessageTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  whatsAppConnection    WhatsAppConnection?    @relation(fields: [whatsAppConnectionId], references: [id], onDelete: SetNull)
  recoveryCampaign      RecoveryCampaign?      @relation(fields: [recoveryCampaignId], references: [id], onDelete: SetNull)
  paymentIntent         PaymentIntent?         @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  billingExecutions     BillingExecution[]
  recoveryStep          RecoveryCampaignStep?
  billingResponse       BillingResponse?
  items                 MessageDispatchItem[]
  receivableAuditEvents ReceivableAuditEvent[]
  whatsappMessages      WhatsAppMessage[]

  @@index([clientId])
  @@index([clientReferenceId])
  @@index([receivableId])
  @@index([templateId])
  @@index([whatsAppConnectionId])
  @@index([recoveryCampaignId])
  @@index([paymentIntentId])
  @@index([status])
  @@index([origin])
  @@index([scheduledFor])
  @@index([nextAttemptAt])
  @@index([createdAt])
  @@map("message_dispatches")
}

model MessageDispatchItem {
  id                String           @id @default(uuid()) @db.Uuid
  messageDispatchId String           @db.Uuid
  receivableId      String           @db.Uuid
  clientReferenceId String           @db.Uuid
  amount            Decimal          @db.Decimal(12, 2)
  dueDate           DateTime         @db.Date
  referenceSnapshot String
  statusSnapshot    ReceivableStatus
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  messageDispatch   MessageDispatch  @relation(fields: [messageDispatchId], references: [id], onDelete: Cascade)
  receivable        Receivable       @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  clientReference   ClientReference  @relation(fields: [clientReferenceId], references: [id], onDelete: Restrict)

  @@unique([messageDispatchId, receivableId])
  @@index([receivableId])
  @@index([clientReferenceId])
  @@index([dueDate])
  @@map("message_dispatch_items")
}

model BillingExecution {
  id                    String                       @id @default(uuid()) @db.Uuid
  messageDispatchId     String                       @db.Uuid
  clientId              String                       @db.Uuid
  paymentIntentId       String?                      @unique @db.Uuid
  executionKey          String                       @unique
  cycleKey              String
  receivableSetHash     String                       @db.VarChar(64)
  authorizationMode     BillingAuthorizationMode
  status                BillingExecutionStatus       @default(SCHEDULED)
  pixStatus             BillingPixStatus             @default(NOT_STARTED)
  deliveryStatus        BillingDeliveryStatus        @default(NOT_READY)
  leaseOwner            String?
  leaseToken            String?                      @unique
  leaseExpiresAt        DateTime?
  nextAttemptAt         DateTime?
  blockedCode           String?
  blockedReason         String?
  reviewRequired        Boolean                      @default(false)
  isCurrent             Boolean                      @default(true)
  supersededAt          DateTime?
  supersedesExecutionId String?                      @db.Uuid
  lastActorType         BillingActorType             @default(SYSTEM)
  lastActorUserId       String?                      @db.Uuid
  lastMutationReason    String?
  version               Int                          @default(0)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  messageDispatch       MessageDispatch              @relation(fields: [messageDispatchId], references: [id], onDelete: Restrict)
  client                Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  paymentIntent         PaymentIntent?               @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  supersedesExecution   BillingExecution?            @relation("BillingExecutionSupersession", fields: [supersedesExecutionId], references: [id], onDelete: Restrict)
  supersededBy          BillingExecution[]           @relation("BillingExecutionSupersession")
  lastActorUser         User?                        @relation("BillingExecutionLastActor", fields: [lastActorUserId], references: [id], onDelete: Restrict)
  receivables           BillingExecutionReceivable[]
  pixAttempts           BillingPixAttempt[]
  events                BillingExecutionEvent[]
  orphanCorrelationEvents BillingPixOrphanWebhookCorrelationEvent[]
  orphanCorrelationClaims BillingPixOrphanWebhookCorrelationClaim[]

  @@index([messageDispatchId, isCurrent])
  @@index([clientId, cycleKey, isCurrent])
  @@index([supersedesExecutionId])
  @@index([lastActorUserId])
  @@index([status, nextAttemptAt])
  @@index([pixStatus])
  @@index([deliveryStatus])
  @@index([reviewRequired])
  @@index([leaseExpiresAt])
  @@index([createdAt])
  @@map("billing_executions")
}

model BillingExecutionReceivable {
  id                 String           @id @default(uuid()) @db.Uuid
  billingExecutionId String           @db.Uuid
  receivableId       String           @db.Uuid
  clientReferenceId  String           @db.Uuid
  amountSnapshot     Decimal          @db.Decimal(12, 2)
  dueDateSnapshot    DateTime         @db.Date
  statusSnapshot     ReceivableStatus
  referenceSnapshot  String
  createdAt          DateTime         @default(now())
  billingExecution   BillingExecution @relation(fields: [billingExecutionId], references: [id], onDelete: Restrict)
  receivable         Receivable       @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  clientReference    ClientReference  @relation(fields: [clientReferenceId], references: [id], onDelete: Restrict)

  @@unique([billingExecutionId, receivableId])
  @@index([billingExecutionId])
  @@index([receivableId])
  @@index([clientReferenceId])
  @@index([dueDateSnapshot])
  @@map("billing_execution_receivables")
}

model BillingPixAttempt {
  id                     String               @id @default(uuid()) @db.Uuid
  billingExecutionId     String               @db.Uuid
  paymentIntentId        String?              @unique @db.Uuid
  creationKey            String               @unique
  isCurrent              Boolean              @default(true)
  status                 BillingPixStatus     @default(RESERVED)
  provider               PaymentProviderCode?
  providerCorrelationId  String?
  providerTransactionId  String?
  failureCode            String?
  failureMessage         String?
  reviewRequired         Boolean              @default(false)
  reconciledAt           DateTime?
  reconciliationEvidence String?
  startedAt              DateTime?
  confirmedAt            DateTime?
  finishedAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  billingExecution       BillingExecution     @relation(fields: [billingExecutionId], references: [id], onDelete: Restrict)
  paymentIntent          PaymentIntent?       @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  orphanCorrelationEvents BillingPixOrphanWebhookCorrelationEvent[]
  orphanCorrelationClaims BillingPixOrphanWebhookCorrelationClaim[]

  @@unique([provider, providerTransactionId])
  @@index([billingExecutionId, status])
  @@index([billingExecutionId, isCurrent])
  @@index([reviewRequired])
  @@index([createdAt])
  @@map("billing_pix_attempts")
}

model BillingExecutionEvent {
  id                 String                    @id @default(uuid()) @db.Uuid
  billingExecutionId String                    @db.Uuid
  eventType          BillingExecutionEventType
  actorType          BillingActorType
  actorUserId        String?                   @db.Uuid
  origin             BillingAuditOrigin        @default(BILLING)
  reason             String?
  metadata           Json?
  createdAt          DateTime                  @default(now())
  billingExecution   BillingExecution          @relation(fields: [billingExecutionId], references: [id], onDelete: Restrict)
  actorUser          User?                     @relation("BillingExecutionEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([billingExecutionId, createdAt])
  @@index([eventType])
  @@index([actorType])
  @@index([actorUserId])
  @@map("billing_execution_events")
}

// Owner-provisioned HMAC material. Ignored by Prisma so application code cannot
// accidentally expose or query signing secrets through the generated client.
model BillingActorKey {
  actorType BillingActorType
  keyId     String
  secret    Bytes
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@id([actorType, keyId])
  @@map("billing_actor_keys")
  @@ignore
}

// One-shot nonce ledger for signed financial actor assertions.
model BillingActorAssertion {
  nonce              String           @id @db.Uuid
  actorType          BillingActorType
  actorUserId        String?          @db.Uuid
  principal          String
  keyId              String
  operation          String
  billingExecutionId String           @db.Uuid
  messageDispatchId  String           @db.Uuid
  receivableId       String?          @db.Uuid
  financialSetDigest String
  expectedVersion    Int
  argumentsDigest    String
  issuedAtEpoch      BigInt
  consumedAt         DateTime         @default(now())

  @@map("billing_actor_assertions")
  @@ignore
}

// Immutable, digest-only evidence for an authenticated provider webhook that
// cannot yet be associated with a trusted local PaymentIntent. Ingestion and
// correlation are deliberately separate follow-up operations.
model BillingPixOrphanWebhookEvent {
  id                    String              @id @db.Uuid
  evidenceVersion       String
  provider              PaymentProviderCode
  providerTransactionId String
  eventKey              String
  externalStatus        String
  rawBodyDigest         String
  rawBodyBytes          Int
  receivedAt            DateTime            @db.Timestamptz(3)
  actorPrincipal        String
  actorKeyId            String
  actorNonce            String              @unique @db.Uuid
  createdAt             DateTime            @default(now())
  correlationEvents     BillingPixOrphanWebhookCorrelationEvent[]
  correlationClaim      BillingPixOrphanWebhookCorrelationClaim?

  @@unique([provider, providerTransactionId, eventKey, rawBodyDigest])
  @@index([provider, providerTransactionId])
  @@index([receivedAt])
  @@map("billing_pix_orphan_webhook_events")
}

model BillingPixOrphanWebhookCorrelationEvent {
  id                    String                              @id @db.Uuid
  correlationVersion    String
  orphanWebhookEventId  String                              @db.Uuid
  decision              BillingPixOrphanCorrelationDecision
  reasonCode            String
  decisionDigest        String                              @unique
  provider              PaymentProviderCode
  providerTransactionId String
  billingPixAttemptId   String?                             @db.Uuid
  billingExecutionId    String?                             @db.Uuid
  paymentIntentId       String?                             @db.Uuid
  creationKey           String?
  financialSetDigest    String
  expectedVersion       Int
  actorType             BillingActorType
  actorPrincipal        String
  actorKeyId            String
  actorNonce            String                              @unique @db.Uuid
  argumentsDigest       String
