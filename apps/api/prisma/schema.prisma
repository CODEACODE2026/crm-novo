generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum ClientStatus {
  ATIVO
  INATIVO
  CANCELADO
}

enum ClientEventType {
  CLIENT_CREATED
  CLIENT_UPDATED
  STATUS_CHANGED
  CLIENT_RENEWED
}

enum ReceivableStatus {
  PENDENTE
  PAGO
  CANCELADO
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  email                 String                @unique
  passwordHash          String
  role                  UserRole              @default(ADMIN)
  active                Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdClientEvents   ClientEvent[]         @relation("ClientEventCreatedBy")
  changedClientStatuses ClientStatusHistory[] @relation("ClientStatusChangedBy")
  createdRenewals       Renewal[]             @relation("RenewalCreatedBy")

  @@map("users")
}

model Plan {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @unique
  durationMonths Int
  defaultValue   Decimal   @db.Decimal(12, 2)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  clients        Client[]
  renewals       Renewal[]

  @@map("plans")
}

model Client {
  id                String                @id @default(uuid()) @db.Uuid
  name              String
  phone             String
  phoneNormalized   String                @unique
  email             String?
  reference         String                @unique
  planId            String                @db.Uuid
  recurringValue    Decimal               @db.Decimal(12, 2)
  dueDate           DateTime              @db.Date
  billingAnchorDay  Int
  billingNoticeDays Int
  notes             String?
  status            ClientStatus          @default(ATIVO)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  plan              Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  statusHistory     ClientStatusHistory[]
  events            ClientEvent[]
  renewals          Renewal[]
  receivables       Receivable[]

  @@index([status])
  @@index([planId])
  @@index([dueDate])
  @@index([createdAt])
  @@map("clients")
}

model Renewal {
  id              String      @id @default(uuid()) @db.Uuid
  clientId        String      @db.Uuid
  planId          String      @db.Uuid
  previousDueDate DateTime    @db.Date
  newDueDate      DateTime    @db.Date
  amount          Decimal     @db.Decimal(12, 2)
  planName        String
  durationMonths  Int
  idempotencyKey  String?
  createdByUserId String?     @db.Uuid
  createdAt       DateTime    @default(now())
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  plan            Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy       User?       @relation("RenewalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  receivable      Receivable?

  @@unique([clientId, idempotencyKey])
  @@index([clientId])
  @@index([planId])
  @@index([createdAt])
  @@map("renewals")
}

model Receivable {
  id          String           @id @default(uuid()) @db.Uuid
  clientId    String           @db.Uuid
  renewalId   String           @unique @db.Uuid
  description String
  amount      Decimal          @db.Decimal(12, 2)
  dueDate     DateTime         @db.Date
  status      ReceivableStatus @default(PENDENTE)
  paidAt      DateTime?
  canceledAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  renewal     Renewal          @relation(fields: [renewalId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([dueDate])
  @@index([status])
  @@map("receivables")
}

model ClientStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  clientId        String       @db.Uuid
  previousStatus  ClientStatus
  newStatus       ClientStatus
  reason          String?
  changedByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  changedBy       User?        @relation("ClientStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdAt])
  @@map("client_status_history")
}

model ClientEvent {
  id              String          @id @default(uuid()) @db.Uuid
  clientId        String          @db.Uuid
  type            ClientEventType
  title           String
  description     String?
  metadata        Json?
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy       User?           @relation("ClientEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([type])
  @@index([createdAt])
  @@map("client_events")
}
