generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum ClientStatus {
  ATIVO
  INATIVO
  CANCELADO
}

enum ClientEventType {
  CLIENT_CREATED
  CLIENT_UPDATED
  STATUS_CHANGED
}

model User {
  id                     String                @id @default(uuid()) @db.Uuid
  name                   String
  email                  String                @unique
  passwordHash           String
  role                   UserRole              @default(ADMIN)
  active                 Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  createdClientEvents    ClientEvent[]         @relation("ClientEventCreatedBy")
  changedClientStatuses  ClientStatusHistory[] @relation("ClientStatusChangedBy")

  @@map("users")
}

model Plan {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  durationMonths Int
  defaultValue   Decimal  @db.Decimal(12, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  clients        Client[]

  @@map("plans")
}

model Client {
  id                String                @id @default(uuid()) @db.Uuid
  name              String
  phone             String
  phoneNormalized   String                @unique
  email             String?
  reference         String                @unique
  planId            String                @db.Uuid
  recurringValue    Decimal               @db.Decimal(12, 2)
  dueDate           DateTime              @db.Date
  billingNoticeDays Int
  notes             String?
  status            ClientStatus          @default(ATIVO)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  plan              Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  statusHistory     ClientStatusHistory[]
  events            ClientEvent[]

  @@index([status])
  @@index([planId])
  @@index([dueDate])
  @@index([createdAt])
  @@map("clients")
}

model ClientStatusHistory {
  id              String       @id @default(uuid()) @db.Uuid
  clientId        String       @db.Uuid
  previousStatus  ClientStatus
  newStatus       ClientStatus
  reason          String?
  changedByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  changedBy       User?        @relation("ClientStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdAt])
  @@map("client_status_history")
}

model ClientEvent {
  id              String          @id @default(uuid()) @db.Uuid
  clientId        String          @db.Uuid
  type            ClientEventType
  title           String
  description     String?
  metadata        Json?
  createdByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now())
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy       User?           @relation("ClientEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([type])
  @@index([createdAt])
  @@map("client_events")
}
