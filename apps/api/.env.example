NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://crm_novo:change-me@localhost:5432/crm_novo_dev?schema=public
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=12
APP_TIMEZONE=America/Sao_Paulo
KIRAGO_BASE_URL=https://kirago.example.com
KIRAGO_ADMIN_TOKEN=replace-with-kirago-admin-token
KIRAGO_HTTP_TIMEOUT_MS=8000
CRM_API_PUBLIC_URL=https://api.example.com
WHATSAPP_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-encryption-key

# Required only when running pnpm --filter @crm-novo/api prisma:seed
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
